{
	"name": "@graphrefly/reactive-layout-node-canvas",
	"version": "0.1.0",
	"description": "node-canvas text measurement provider for GraphReFly reactive layout.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/graphrefly/graphrefly-react.git",
		"directory": "packages/reactive-layout-node-canvas"
	},
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"package.json"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm,cjs --dts --clean && node ../../scripts/check-ecosystem-package.mjs .",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@graphrefly/ts": ">=0.6.2 <1.0.0",
		"canvas": "^3.2.3"
	},
	"peerDependenciesMeta": {
		"canvas": {
			"optional": true
		}
	},
	"devDependencies": {
		"@graphrefly/ts": "0.6.2",
		"tsup": "^8.5.1",
		"typescript": "^5.7.0",
		"vitest": "^4.1.7"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT"
}
